{
  "name": "dsh-token-cost",
  "version": "0.3.7",
  "description": "DSH Token 花费面板（社区插件，非官方）：DeepSeek + GLM（智谱）/ Kimi（月之暗面）按模型计价 · 无预算模式 · 侧栏今日花费 · 自然月/季/年统计 · 峰谷计价 · 明细 · CSV·JSON 导出 · CLI 报表。Community token cost panel for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools/report.mjs",
    "docs/*.png",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "token",
    "token-usage",
    "usage",
    "usage-statistics",
    "cost",
    "cost-tracking",
    "balance",
    "account",
    "billing",
    "budget",
    "pricing",
    "peak",
    "dashboard",
    "panel",
    "export",
    "csv",
    "cli",
    "glm",
    "zhipu",
    "kimi",
    "moonshot",
    "third-party"
  ],
  "homepage": "https://github.com/catgrandfa/dsh-token-cost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catgrandfa/dsh-token-cost.git"
  },
  "bugs": {
    "url": "https://github.com/catgrandfa/dsh-token-cost/issues"
  },
  "author": "catgrandfa",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "watch": "node tools/build-client.mjs --watch",
    "setup": "node tools/setup-modules.mjs",
    "report": "node tools/report.mjs",
    "test": "node tools/verify-generations.mjs && node tools/verify-core.mjs && node tools/verify-zstd.mjs && node tools/verify-rates.mjs && node tools/verify-storage.mjs && node tools/verify-report.mjs && node tools/verify-tools.mjs && node tools/smoke-host.mjs && node tools/smoke-client.mjs && node tools/smoke-render.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
